{
  "name": "creative-image-voting-platform",
  "version": "1.0.0",
  "description": "Clean, responsive full-stack web application powered by PostgreSQL for mentor-managed student creative image voting sessions.",
  "main": "server/index.js",
  "scripts": {
    "server": "node server/index.js",
    "client": "vite client --config client/vite.config.js",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build": "vite build client --config client/vite.config.js",
    "start": "node server/index.js",
    "db:migrate": "node server/db/migrate.js",
    "db:seed": "node server/db/seed.js"
  },
  "keywords": [
    "voting",
    "postgresql",
    "aiven",
    "education",
    "mentor",
    "student-voting",
    "creative-thinking"
  ],
  "author": "Antigravity",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "canvas-confetti": "^1.9.4",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^1.16.0",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.16.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "pg-mem": "^3.0.4",
    "vite": "^6.2.1"
  }
}
