# ===================================================
# Creative Image Voting Platform — Production Environment
# ===================================================

# Node Environment ('production' or 'development')
NODE_ENV=production

# Server Port (Default: 5000)
PORT=5000

# Aiven PostgreSQL Connection String (REQUIRED for Production)
DATABASE_URL=postgres://avnadmin:your_aiven_password@your-aiven-pg.aivencloud.com:28471/defaultdb?sslmode=require
PGSSLMODE=require

# JWT Secret Key for Mentor Authentication (REQUIRED for Production)
JWT_SECRET=set_a_long_random_secure_jwt_secret_key_2026_here

# Initial Mentor Account Credentials (Created during database migration)
MENTOR_INITIAL_EMAIL=mentor@voting.com
MENTOR_INITIAL_PASSWORD=SetYourStrongMentorPasswordHere123!

# Configurable CORS Allowed Origin
CORS_ORIGIN=*

# Image Storage Provider ('cloudinary' for production, 'local' for dev)
STORAGE_PROVIDER=cloudinary

# Cloudinary Credentials (REQUIRED when STORAGE_PROVIDER=cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Uploaded Image Directory (Used when STORAGE_PROVIDER=local)
UPLOADS_DIR=/var/data/uploads
